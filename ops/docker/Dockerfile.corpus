FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS native-build

ARG LKJAI_CUDA_ARCHS
ARG LKJAI_GIT_COMMIT=unknown
ENV LKJAI_CUDA_ARCHS=${LKJAI_CUDA_ARCHS}

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY native ./native
COPY configs ./configs
COPY third_party ./third_party

RUN cmake -S native -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DLKJAI_GIT_COMMIT_OVERRIDE=${LKJAI_GIT_COMMIT} \
    && cmake --build /build --target lkjai-native-packed-cache lkjai-native-tokenizer-build --parallel

FROM nvidia/cuda:12.8.1-base-ubuntu24.04

ENV HF_HOME=/app/data/hf-home \
    HF_HUB_DOWNLOAD_TIMEOUT=60 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages --no-cache-dir \
      "huggingface_hub[cli]" \
      pyarrow \
      requests

COPY --from=native-build /build/lkjai-native-packed-cache /usr/local/bin/
COPY --from=native-build /build/lkjai-native-tokenizer-build /usr/local/bin/
COPY ops/corpus/public_pretrain_tool /usr/local/bin/lkjai-public-pretrain
COPY ops/corpus/public_pretrain /usr/local/lib/public_pretrain
COPY ops/corpus/kimi_sft_tool /usr/local/bin/lkjai-kimi-sft
COPY ops/corpus/kimi_sft /usr/local/lib/kimi_sft
COPY ops/corpus/entrypoint.sh /usr/local/bin/lkjai-corpus-entrypoint

RUN chmod +x /usr/local/bin/lkjai-public-pretrain \
    /usr/local/bin/lkjai-kimi-sft \
    /usr/local/bin/lkjai-corpus-entrypoint

ENTRYPOINT ["lkjai-corpus-entrypoint"]
