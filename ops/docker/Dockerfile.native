FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS build

ARG LKJAI_CUDA_ARCHS
ARG LKJAI_GIT_COMMIT=unknown
ENV LKJAI_CUDA_ARCHS=${LKJAI_CUDA_ARCHS}

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY native ./native
COPY configs ./configs
COPY third_party ./third_party

RUN cmake -S native -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DLKJAI_GIT_COMMIT_OVERRIDE=${LKJAI_GIT_COMMIT} \
    && cmake --build /build --parallel

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ARG LKJAI_CUDA_ARCHS
ARG LKJAI_GIT_COMMIT=unknown
ENV LKJAI_CUDA_ARCHS=${LKJAI_CUDA_ARCHS}

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/lkjai-native-server /usr/local/bin/lkjai-native-server
COPY --from=build /build/lkjai-native-runtime /usr/local/bin/lkjai-native-runtime
COPY --from=build /build/lkjai-native-train /usr/local/bin/lkjai-native-train
COPY --from=build /build/lkjai-native-inspect /usr/local/bin/lkjai-native-inspect
COPY --from=build /build/lkjai-native-infer /usr/local/bin/lkjai-native-infer
COPY --from=build /build/lkjai-native-dense-check /usr/local/bin/lkjai-native-dense-check
COPY --from=build /build/lkjai-native-device-check /usr/local/bin/lkjai-native-device-check
COPY --from=build /build/lkjai-native-logits-check /usr/local/bin/lkjai-native-logits-check
COPY --from=build /build/lkjai-native-packed-cache /usr/local/bin/lkjai-native-packed-cache
COPY --from=build /build/lkjai-native-tokenizer-build /usr/local/bin/lkjai-native-tokenizer-build
COPY --from=build /build/lkjai-native-repo-check /usr/local/bin/lkjai-native-repo-check
COPY --from=build /build/lkjai-native-packed-cache-reader-check /usr/local/bin/lkjai-native-packed-cache-reader-check

ENV MODEL_ROOT=/models
ENV MODEL_NAME=decoder-40m-3070
ENV INFERENCE_HOST=0.0.0.0
ENV INFERENCE_PORT=8081

EXPOSE 8081
ENTRYPOINT ["lkjai-native-server"]
