APP_HOST=127.0.0.1
APP_PORT=8080
DATA_DIR=/app/data
MODEL_API_URL=http://inference:8081/v1/chat/completions
MODEL_NAME=lkjai-scratch-40m
TRAIN_MODEL_NAME=dense-40m-3070
TOOL_WORKSPACE_DIR=/app/data/workspace
NVIDIA_VISIBLE_DEVICES=all
TRAIN_DATA_DIR=/app/data/train
TRAIN_CONFIG=/workspace/configs/training/dense_40m_accepted_3070.json
TRAIN_NATIVE_CONFIG=/workspace/configs/native/native_dense_40m_bf16_3070.json
TRAIN_BEHAVIORAL_CHECKPOINT=export
TRAIN_XML_VALIDITY_THRESHOLD=0.95
TRAIN_EVERYDAY_CHAT_THRESHOLD=0.90
TRAIN_COMMITTED_CORPUS_DIR=/workspace/corpus/generated/kimi-sft-60m
TRAIN_CORPUS_DIR=/app/data/public-corpus
TRAIN_PUBLIC_DATA_DIR=/app/data/raw/cosmopedia
TRAIN_PUBLIC_PRETRAIN_TOKENS=500000000
HF_HOME=/app/data/hf-home
HF_SECRET_FILE=./data/secrets/hf_token
HF_TOKEN_FILE=/run/secrets/hf_token_source
